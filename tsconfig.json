{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "isolatedModules": true,
    "incremental": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src",
    "vitest.config.ts",
    "playwright*.config.ts",
    "tests",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

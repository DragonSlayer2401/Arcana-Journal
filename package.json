{
  "name": "arcana-journal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/test-sw.mjs",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/check-art.mjs && vite build && node scripts/build-sw.mjs && node scripts/check-art.mjs --built",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:cloud": "node --test --test-concurrency=1 scripts/test-cloud-journal.mjs scripts/test-cloud-ui.mjs",
    "test:update": "playwright test --config playwright.update.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.6"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
